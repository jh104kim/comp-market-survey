{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepAgentOutput",
  "type": "object",
  "required": [
    "agent_name",
    "executive_mini_summary",
    "research_questions",
    "detailed_findings",
    "evidence_register",
    "samsung_implications",
    "gap_analysis",
    "catch_up_actions",
    "differentiation_options",
    "risks_and_uncertainties",
    "open_questions",
    "confidence"
  ],
  "properties": {
    "agent_name": { "type": "string" },
    "executive_mini_summary": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string" }
    },
    "research_questions": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    },
    "search_queries": {
      "type": "array",
      "minItems": 10,
      "items": { "type": "string" }
    },
    "detailed_findings": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["finding", "evidence", "interpretation", "samsung_relevance", "confidence"],
        "properties": {
          "finding": { "type": "string" },
          "evidence": { "type": "string" },
          "interpretation": { "type": "string" },
          "samsung_relevance": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          }
        }
      }
    },
    "comparison_table": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "item": { "type": "string" },
          "current_signal": { "type": "string" },
          "evidence": { "type": "string" },
          "samsung_implication": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          }
        }
      }
    },
    "technology_or_market_logic": { "type": "string" },
    "evidence_register": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": ["source", "source_type", "relevance", "reliability"],
        "properties": {
          "source": { "type": "string" },
          "source_type": {
            "type": "string",
            "enum": [
              "Official",
              "Regulatory",
              "Standards",
              "Patent",
              "Paper",
              "Industry News",
              "Secondary",
              "Marketing"
            ]
          },
          "date": { "type": "string" },
          "relevance": { "type": "string" },
          "reliability": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          }
        }
      }
    },
    "samsung_implications": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string" }
    },
    "gap_analysis": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "gap": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "evidence": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          },
          "verification_needed": { "type": "string" }
        }
      }
    },
    "catch_up_actions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "action": { "type": "string" },
          "timing": { "type": "string" },
          "owner_candidate": { "type": "string" },
          "evidence_basis": { "type": "string" },
          "expected_outcome": { "type": "string" }
        }
      }
    },
    "differentiation_options": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "option": { "type": "string" },
          "why_it_could_differentiate": { "type": "string" },
          "timing": { "type": "string" },
          "dependencies": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          }
        }
      }
    },
    "risks_and_uncertainties": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string" }
    },
    "fact_inference_assumption_split": {
      "type": "object",
      "properties": {
        "facts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inferences": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "appendix_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "string",
      "enum": ["High", "Medium", "Low"]
    }
  }
}
